AWSTemplateFormatVersion: "2010-09-09"
Description: Serverless weather data pipeline (S3, Lambda, EventBridge, 
Glue, Athena)

Parameters:
  Prefix:
    Type: String
    Default: dharani
    AllowedPattern: "^[a-z0-9-]{3,20}$"
    Description: Lowercase prefix for resource names
  ScheduleExpression:
    Type: String
    Default: cron(0 6 * * ? *)

Resources:
  # ---------- S3 ----------
  BronzeBucket:
    Type: AWS::S3::Bucket
    Properties:
      BucketName: !Sub 
"${Prefix}-weather-bronze-${AWS::AccountId}-${AWS::Region}"
      BucketEncryption:
        ServerSideEncryptionConfiguration:
          - ServerSideEncryptionByDefault: { SSEAlgorithm: AES256 }
      PublicAccessBlockConfiguration:
        BlockPublicAcls: true
        BlockPublicPolicy: true
        IgnorePublicAcls: true
        RestrictPublicBuckets: true

  SilverBucket:
    Type: AWS::S3::Bucket
    Properties:
      BucketName: !Sub 
"${Prefix}-weather-silver-${AWS::AccountId}-${AWS::Region}"
      BucketEncryption:
        ServerSideEncryptionConfiguration:
          - ServerSideEncryptionByDefault: { SSEAlgorithm: AES256 }
      PublicAccessBlockConfiguration:
        BlockPublicAcls: true
        BlockPublicPolicy: true
        IgnorePublicAcls: true
        RestrictPublicBuckets: true

  ArtifactsBucket:
    Type: AWS::S3::Bucket
    Properties:
      BucketName: !Sub 
"${Prefix}-weather-artifacts-${AWS::AccountId}-${AWS::Region}"
      BucketEncryption:
        ServerSideEncryptionConfiguration:
          - ServerSideEncryptionByDefault: { SSEAlgorithm: AES256 }
      PublicAccessBlockConfiguration:
        BlockPublicAcls: true
        BlockPublicPolicy: true
        IgnorePublicAcls: true
        RestrictPublicBuckets: true

  # ---------- Lambda ingestion ----------
  LambdaRole:
    Type: AWS::IAM::Role
    Properties:
      AssumeRolePolicyDocument:
        Version: "2012-10-17"
        Statement:
          - Effect: Allow
            Principal: { Service: lambda.amazonaws.com }
            Action: sts:AssumeRole
      ManagedPolicyArns:
        - arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole
      Policies:
        - PolicyName: write-bronze-only
          PolicyDocument:
            Version: "2012-10-17"
            Statement:
              - Effect: Allow
                Action: s3:PutObject
                Resource: !Sub "${BronzeBucket.Arn}/*"

  IngestFunction:
    Type: AWS::Lambda::Function
    Properties:
      FunctionName: !Sub "${Prefix}-weather-ingest"
      Runtime: python3.12
      Handler: index.lambda_handler
      Timeout: 60
      MemorySize: 256
      Role: !GetAtt LambdaRole.Arn
      Environment:
        Variables:
          BRONZE_BUCKET: !Ref BronzeBucket
      Code:
        ZipFile: |
          import json, os, urllib.parse, urllib.request
          from datetime import datetime, timezone
          import boto3

          s3 = boto3.client("s3")
          BUCKET = os.environ["BRONZE_BUCKET"]
          CITIES = {
              "new_york": (40.7128, -74.0060), "london": (51.5074, 
-0.1278),
              "tokyo": (35.6762, 139.6503), "sydney": (-33.8688, 
151.2093),
              "dubai": (25.2048, 55.2708), "paris": (48.8566, 2.3522),
              "singapore": (1.3521, 103.8198), "mumbai": (19.0760, 
72.8777),
              "sao_paulo": (-23.5505, -46.6333),
